<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- MEF2, for finding mission plugins only. Parts are handed straight to
         the M.E.DI container, so the composition host owns no lifetimes. The
         convention builder is what lets a plugin export a mission without
         referencing MEF itself. -->
    <PackageReference Include="System.Composition.Convention" />
    <PackageReference Include="System.Composition.Hosting" />
    <PackageReference Include="System.Composition.TypedParts" />
  </ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\..\libs\EliteSharp.Abstractions\EliteSharp.Abstractions.csproj" />
	  <ProjectReference Include="..\..\..\useful\libs\SharpKind.Abstraction\SharpKind.Abstraction.csproj" />
	  <ProjectReference Include="..\..\..\useful\libs\SharpKind.Assets\SharpKind.Assets.csproj" />
	  <ProjectReference Include="..\..\..\useful\libs\SharpKind.Audio\SharpKind.Audio.csproj" />
	  <ProjectReference Include="..\..\..\useful\libs\SharpKind.Input\SharpKind.Input.csproj" />
	  <ProjectReference Include="..\..\..\useful\libs\SharpKind.Graphics\SharpKind.Graphics.csproj" />
	  <ProjectReference Include="..\..\..\useful\libs\SharpKind\SharpKind.csproj" />
	</ItemGroup>

  <ItemGroup>
    <!-- The ship table, which travels with the assembly and is read from
         beside it - Content rather than None, so the apps and the tests that
         reference this project get the file in their own output too. -->
    <Content Include="ships.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
