<Project Sdk="Microsoft.NET.Sdk">

  <!-- The 8-bit rendition: its screens, its renderers, and the artwork,
       palette, fonts and ship models they draw with. It references the
       contracts and nothing else - not the game - which is the whole point:
       whatever the game can do for its own renditions it can do for anyone's.
       It is not referenced by the game either; the app's build drops it into
       a folder under Renditions beside the executable, and the loader finds
       it there. -->

  <ItemGroup>
    <ProjectReference Include="..\EliteSharp.Abstractions\EliteSharp.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The assets travel with the assembly, which is why a rendition needs a
         folder of its own: both of the shipped ones have a palette.json and a
         hud.bmp, and they would land on top of each other. -->
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
