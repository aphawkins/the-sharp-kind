<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one plugin-facing assembly: a plugin references this and nothing
       else. Anything reachable from here is published API, so what goes in is
       contracts and the data they carry, never game behaviour.

       Subdivided by namespace rather than by project - Missions, Views, and
       whatever comes next - because a project per plugin family is sprawl
       standing in for a folder.

       The references below are what drawing needs: a view is handed an
       IGraphics and a palette, so they cannot be avoided. Note what that
       costs. The mission contracts were dependency-free on their own, and a
       mission author now transitively carries a graphics assembly they never
       call; what a mission may touch is a namespace boundary now rather than
       a compile error. -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\useful\libs\SharpKind.Abstraction\SharpKind.Abstraction.csproj" />
    <ProjectReference Include="..\..\..\useful\libs\SharpKind.Assets\SharpKind.Assets.csproj" />
    <ProjectReference Include="..\..\..\useful\libs\SharpKind.Graphics\SharpKind.Graphics.csproj" />
    <ProjectReference Include="..\..\..\useful\libs\SharpKind.UI\SharpKind.UI.csproj" />
    <ProjectReference Include="..\..\..\useful\libs\SharpKind\SharpKind.csproj" />
  </ItemGroup>

</Project>
