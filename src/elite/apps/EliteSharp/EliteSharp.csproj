<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>elite.ico</ApplicationIcon>
		<PackageIcon>elite.ico</PackageIcon>
  </PropertyGroup>

	<ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="ppy.SDL3_ttf-CS" />
  </ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\..\useful\libs\SharpKind.App\SharpKind.App.csproj" />
	  <ProjectReference Include="..\..\..\useful\libs\SharpKind.SDL\SharpKind.SDL.csproj" />
	  <ProjectReference Include="..\..\libs\EliteSharpLib\EliteSharpLib.csproj" />
	</ItemGroup>

  <ItemGroup>
    <!-- The missions are plugins, including the two that ship with the game.
         Built and copied, but deliberately not referenced: the game must find
         its own missions the same way it finds anyone else's. -->
    <ProjectReference Include="..\..\libs\EliteSharp.Missions.Classic\EliteSharp.Missions.Classic.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />

    <!-- And so are the goods. Same arrangement as the missions; unlike them,
         and like the renditions, they are not optional - remove the set and
         the game has no market, and says so at startup. -->
    <ProjectReference Include="..\..\libs\EliteSharp.Goods.Classic\EliteSharp.Goods.Classic.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />

    <!-- And so are both tiers of screens. Same arrangement, and the same
         reason: the game must find its own tiers the way it would find
         anyone else's. Unlike the missions, these are not optional - remove
         them and the game has nothing to draw with, and says so at startup. -->
    <ProjectReference Include="..\..\libs\EliteSharp.Renditions.EightBit\EliteSharp.Renditions.EightBit.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
    <ProjectReference Include="..\..\libs\EliteSharp.Renditions.SixteenBit\EliteSharp.Renditions.SixteenBit.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- Into a Missions folder beside the executable, which is where
       MissionLoader looks. CopyToOutputDirectory would flatten it into the
       output root, so the path is set here instead. -->
  <Target Name="CopyMissionPlugins" AfterTargets="Build;Publish">
    <MSBuild Projects="..\..\libs\EliteSharp.Missions.Classic\EliteSharp.Missions.Classic.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="MissionPlugin" />
    </MSBuild>
    <Copy SourceFiles="@(MissionPlugin)"
          DestinationFolder="$(OutDir)Missions"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MissionPlugin)"
          DestinationFolder="$(PublishDir)Missions"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- Into a Goods folder beside the executable, which is where GoodsLoader
       looks. Same shape as the missions above, plus the table itself: the set
       reads goods.json from beside its own assembly, so the two travel
       together. -->
  <Target Name="CopyGoodsPlugins" AfterTargets="Build;Publish">
    <MSBuild Projects="..\..\libs\EliteSharp.Goods.Classic\EliteSharp.Goods.Classic.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="GoodsPlugin" />
    </MSBuild>
    <ItemGroup>
      <GoodsData Include="..\..\libs\EliteSharp.Goods.Classic\goods.json" />
    </ItemGroup>
    <Copy SourceFiles="@(GoodsPlugin);@(GoodsData)"
          DestinationFolder="$(OutDir)Goods"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GoodsPlugin);@(GoodsData)"
          DestinationFolder="$(PublishDir)Goods"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

  <ItemGroup>
    <RenditionProject Include="..\..\libs\EliteSharp.Renditions.EightBit\EliteSharp.Renditions.EightBit.csproj" />
    <RenditionProject Include="..\..\libs\EliteSharp.Renditions.SixteenBit\EliteSharp.Renditions.SixteenBit.csproj" />
  </ItemGroup>

  <!-- Each rendition into a folder of its own under Renditions, which is
       where RenditionLoader looks. A folder rather than a loose DLL because a
       rendition brings its own artwork, palette, fonts and ship models with
       it, and those would collide in one directory - both of the shipped ones
       have a palette.json and a hud.bmp.

       Both are copied whichever one is configured: the rendition is a setting
       the commander can change without reinstalling anything. -->
  <Target Name="CopyRenditions" AfterTargets="Build;Publish">
    <MSBuild Projects="@(RenditionProject)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="RenditionAssembly" />
    </MSBuild>
    <!-- The assembly, and the Assets tree that is the rendition's artwork.
         Taken from the source folder rather than the build output, so this
         does not depend on where a rendition's bin happens to be, and
         RecursiveDir keeps the tree's shape under the copy. -->
    <ItemGroup>
      <RenditionAsset Include="..\..\libs\EliteSharp.Renditions.EightBit\Assets\**\*"
                      Rendition="EliteSharp.Renditions.EightBit" />
      <RenditionAsset Include="..\..\libs\EliteSharp.Renditions.SixteenBit\Assets\**\*"
                      Rendition="EliteSharp.Renditions.SixteenBit" />
    </ItemGroup>
    <Copy SourceFiles="@(RenditionAssembly)"
          DestinationFolder="$(OutDir)Renditions\%(Filename)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RenditionAsset)"
          DestinationFolder="$(OutDir)Renditions\%(RenditionAsset.Rendition)\Assets\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RenditionAssembly)"
          DestinationFolder="$(PublishDir)Renditions\%(Filename)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="@(RenditionAsset)"
          DestinationFolder="$(PublishDir)Renditions\%(RenditionAsset.Rendition)\Assets\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
