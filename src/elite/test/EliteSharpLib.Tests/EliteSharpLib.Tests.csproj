<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\useful\libs\SharpKind.Graphics\SharpKind.Graphics.csproj" />
    <ProjectReference Include="..\..\..\useful\test\SharpKind.Fakes\SharpKind.Fakes.csproj" />
    <ProjectReference Include="..\..\..\useful\test\SharpKind.GoldenFrames\SharpKind.GoldenFrames.csproj" />
    <!-- Referenced directly, unlike the game, because these tests are about
         what the two shipped missions do rather than about finding them. -->
    <ProjectReference Include="..\..\libs\EliteSharp.Missions.Classic\EliteSharp.Missions.Classic.csproj" />
    <!-- Referenced directly for the same reason: some tests are about what the
         classic economy contains, not about finding it. The tests that drive
         the real composition still find the set off disk, via the copy below. -->
    <ProjectReference Include="..\..\libs\EliteSharp.Goods.Classic\EliteSharp.Goods.Classic.csproj" />
    <!-- Referenced for the same reason: the tests below are about what a tier
         draws, not about finding it. The tests that drive the real
         composition still find their packs off disk, via the copy below. -->
    <ProjectReference Include="..\..\libs\EliteSharp.Renditions.EightBit\EliteSharp.Renditions.EightBit.csproj" />
    <ProjectReference Include="..\..\libs\EliteSharp.Renditions.SixteenBit\EliteSharp.Renditions.SixteenBit.csproj" />
    <ProjectReference Include="..\..\libs\EliteSharpLib\EliteSharpLib.csproj" />
    <ProjectReference Include="..\EliteSharpLib.Fakes\EliteSharpLib.Fakes.csproj" />
    <!-- Built and copied, but deliberately not referenced: the loader has to
         find this the way it finds a stranger's plugin, off disk. -->
    <ProjectReference Include="..\EliteSharp.Missions.TestPlugin\EliteSharp.Missions.TestPlugin.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
    <!-- A goods plugin the loader has to find off disk, same as the mission
         one above. -->
    <ProjectReference Include="..\EliteSharp.Goods.TestPlugin\EliteSharp.Goods.TestPlugin.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Graphics\2x2redtopleft.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The goods-file fixtures, read from beside the assembly rather than
         spelled out as JSON in C#. -->
    <None Update="Trader\Fixtures\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The ship-file fixtures, for the same reason. -->
    <None Update="Ships\Fixtures\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Read from the build output so a test run never depends on the source
         tree being where it was compiled. Regenerating writes back to the
         source copy instead - see TraceBaselines. -->
    <None Include="GoldenTrace\Baselines\*.*"
          LinkBase="GoldenTrace\Baselines"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The shipped missions, into a Missions folder, exactly as the app's build
       does it. The tests that drive the game's real composition have to find
       their missions the way the game does, or they would be proving something
       the shipped configuration does not do. -->
  <Target Name="CopyMissionPlugins" AfterTargets="Build">
    <MSBuild Projects="..\..\libs\EliteSharp.Missions.Classic\EliteSharp.Missions.Classic.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="MissionPlugin" />
    </MSBuild>
    <Copy SourceFiles="@(MissionPlugin)"
          DestinationFolder="$(OutDir)Missions"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- The classic goods set, into a Goods folder, exactly as the app's build
       does it - the tests that drive the game's real composition have to find
       the set the way the game does. -->
  <Target Name="CopyGoodsPlugins" AfterTargets="Build">
    <MSBuild Projects="..\..\libs\EliteSharp.Goods.Classic\EliteSharp.Goods.Classic.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="GoodsPlugin" />
    </MSBuild>
    <ItemGroup>
      <GoodsData Include="..\..\libs\EliteSharp.Goods.Classic\goods.json" />
    </ItemGroup>
    <Copy SourceFiles="@(GoodsPlugin);@(GoodsData)"
          DestinationFolder="$(OutDir)Goods"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <RenditionProject Include="..\..\libs\EliteSharp.Renditions.EightBit\EliteSharp.Renditions.EightBit.csproj" />
    <RenditionProject Include="..\..\libs\EliteSharp.Renditions.SixteenBit\EliteSharp.Renditions.SixteenBit.csproj" />
  </ItemGroup>

  <!-- Both renditions, each into a folder of its own under Renditions,
       exactly as the app's build does it. Without this the harness has
       nothing to draw with and every test that builds the real composition
       fails at startup - which is the failure the game is meant to have, so
       it is worth it being the same one. -->
  <Target Name="CopyRenditions" AfterTargets="Build">
    <MSBuild Projects="@(RenditionProject)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="RenditionAssembly" />
    </MSBuild>
    <ItemGroup>
      <RenditionAsset Include="..\..\libs\EliteSharp.Renditions.EightBit\Assets\**\*"
                      Rendition="EliteSharp.Renditions.EightBit" />
      <RenditionAsset Include="..\..\libs\EliteSharp.Renditions.SixteenBit\Assets\**\*"
                      Rendition="EliteSharp.Renditions.SixteenBit" />
    </ItemGroup>
    <Copy SourceFiles="@(RenditionAssembly)"
          DestinationFolder="$(OutDir)Renditions\%(Filename)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RenditionAsset)"
          DestinationFolder="$(OutDir)Renditions\%(RenditionAsset.Rendition)\Assets\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
