{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "elite/libs/*/*.csproj",
            "scr/libs/*/*.csproj",
            "useful/libs/*/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "The Sharp Kind",
      "_appTitle": "The Sharp Kind",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/aphawkins/the-sharp-kind",
        "branch": "main"
      },
      "pdf": false
    }
  }
}
