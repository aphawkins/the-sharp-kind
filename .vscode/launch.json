    "version": "0.2.0",
    "configurations": [
        {
            "name": "Elite",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build elite",
            "program": "${workspaceFolder}/src/elite/apps/EliteSharp/bin/Debug/net10.0/EliteSharp.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/elite/apps/EliteSharp",
            "console": "internalConsole",
            "stopAtEntry": false,
            "sourceFileMap": {
                "/_": "${workspaceFolder}"
            }
        },
        {
            "name": "Bubble Bobble",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build bb",
            "program": "${workspaceFolder}/src/bb/apps/BubbleBobbleSharp/bin/Debug/net10.0/BubbleBobbleSharp.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/bb/apps/BubbleBobbleSharp",
            "console": "internalConsole",
            "stopAtEntry": false,
            "sourceFileMap": {
                "/_": "${workspaceFolder}"
            }
        },
        {
            "name": "Stunt Car Racer",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build scr",
            "program": "${workspaceFolder}/src/scr/apps/StuntCarRacerSharp/bin/Debug/net10.0/StuntCarRacerSharp.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/scr/apps/StuntCarRacerSharp",
            "console": "internalConsole",
            "stopAtEntry": false,
            "sourceFileMap": {
                "/_": "${workspaceFolder}"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}